import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox } from "std-widgets.slint";

// Çeviri metinleri — değerler Rust tarafında (i18n.rs + locales/*.json) doldurulur
export global Tr {
    in property <string> settings;
    in property <string> my_syncs;
    in property <string> find_from_cloud;
    in property <string> logout;
    in property <string> check_updates;
    in property <string> sync_code_title;
    in property <string> cancel;
    in property <string> connect;
    in property <string> login_google;
    in property <string> retry;
    in property <string> new_sync;
    in property <string> connect_to_code;
    in property <string> copy_code;
    in property <string> copied;
    in property <string> main_menu;
    in property <string> stop_and_delete;
    in property <string> no_syncs_title;
    in property <string> no_syncs_hint;
    in property <string> status_syncing;
    in property <string> status_connected;
    in property <string> status_connecting;
    in property <string> status_waiting_login;
    in property <string> quit_title;
    in property <string> quit_body;
    in property <string> quit;
    in property <string> section_startup;
    in property <string> autostart;
    in property <string> start_in_tray;
    in property <string> section_performance;
    in property <string> threads_label;
    in property <string> threads_hint;
    in property <string> language_label;
    in property <string> section_system;
    in property <string> remove_sync_title;
    in property <string> remove_sync_body;
    in property <string> delete_from_drive;
    in property <string> remove;
    in property <string> update_ready_title;
    in property <string> update_ready_body;
    in property <string> later;
    in property <string> restart;
}


component Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();
    
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: !enabled ? #31324480 : (checked ? #a6e3a1 : #45475a);
    
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? #11111b : #181825;
        x: checked ? root.width - self.width - 2px : 2px;
        y: 2px;
        animate x { duration: 150ms; easing: ease-in-out; }
    }
    
    TouchArea {
        clicked => { 
            if (root.enabled) { 
                root.checked = !root.checked; 
                root.toggled(); 
            } 
        }
    }
}

export struct SyncFolderItem {
    id: string,
    name: string,
    path: string,
    status: string,
    is_syncing: bool,
    code: string,
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.pressed ? #313244 : (ta.has-hover ? #1e1e2e : transparent);

    if (text != ""): Text {
        text: root.text;
        color: ta.has-hover ? #cdd6f4 : #a6adc8;
        font-size: 1.2rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (text == ""): Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: ta.has-hover ? #cdd6f4 : #a6adc8;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component DarkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa : #45475a;
    background: ta.pressed ? #1e1e2e : (ta.has-hover ? #313244 : #181825);

    Text {
        text: root.text;
        color: #cdd6f4;
        font-weight: 600;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component ModernButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: ta.pressed ? #74c7ec : (ta.has-hover ? #89dceb : #89b4fa);

    Text {
        text: root.text;
        color: #11111b;
        font-weight: 700;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component SmoothSpinner inherits Rectangle {
    width: 30px;
    height: 30px;
    property <angle> rot: 0deg;

    Timer {
        interval: 16ms;
        running: true;
        triggered => { root.rot += 8deg; }
    }

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("emojis/spinner.svg");
        transform-rotation: root.rot;
    }
}

component AppLogo inherits Rectangle {
    // scale: 1.0 = orijinal boyut (400x180 kutu), 1.5 = %50 büyük.
    // Resim bu ölçekte çizilir, pencereye sığması için kırpılır (PNG'deki şeffaf boşluk da kırpılır).
    in property <float> scale: 1.25;
    in property <length> box-height: 170px;
    height: root.box-height;
    clip: true;

    Image {
        source: @image-url("../assets/logo.png");
        width: 400px * root.scale;
        height: 180px * root.scale;
        image-fit: contain;
        // -7px: PNG içindeki hafif sağa kaymayı telafi eder
        x: (parent.width - self.width) / 2 - 7px * root.scale;
        y: (parent.height - self.height) / 2;
    }
}

component SyncCodeDialog inherits Rectangle {
    in-out property <string> input_code: "";
    callback confirmed(string);
    callback cancelled();

    width: 320px;
    height: 180px;
    background: #1e1e2e;
    border-radius: 12px;
    border-width: 1px;
    border-color: #313244;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        alignment: center;

        Text {
            text: Tr.sync_code_title;
            color: #cdd6f4;
            font-size: 1.1rem;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 40px;
            background: #181825;
            border-radius: 6px;
            border-width: 1px;
            border-color: input.has-focus ? #89b4fa : #313244;

            // Kutunun her yerine tıklayınca odak versin (TextInput'un ALTINDA kalır)
            TouchArea {
                clicked => { input.focus(); }
            }

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.input_code;
                color: #cdd6f4;
                font-size: 0.95rem;
                vertical-alignment: center;
                horizontal-alignment: center;
                single-line: true;

                accepted => { root.confirmed(self.text); }
            }
        }

        HorizontalLayout {
            spacing: 15px;
            alignment: center;
            ModernButton {
                text: Tr.cancel;
                width: 100px;
                clicked => { root.cancelled() }
            }
            ModernButton {
                text: Tr.connect;
                width: 100px;
                clicked => { root.confirmed(root.input_code) }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "ConnectSync";
    width: 400px;
    height: 560px;
    background: #1e1e2e;
    no-frame: true;
    default-font-family: "Segoe UI";

    forward-focus: fs;
    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                if (root.show_settings) {
                    root.show_settings = false; root.error_text = "";
                    return accept;
                }
                if (root.show_my_syncs) {
                    root.show_my_syncs = false; root.error_text = "";
                    return accept;
                }
                if (root.show_connect_dialog) {
                    root.show_connect_dialog = false; root.error_text = "";
                    return accept;
                }
            }
            return reject;
        }
    }


    in-out property <bool> is_logged_in: false;
    in-out property <bool> is_logging_in: false;
    in-out property <string> error_text: "";
    in-out property <[SyncFolderItem]> sync_folders: [];
    in-out property <[SyncFolderItem]> cloud_folders: [];
    in-out property <bool> is_syncing: false;

    // UI state
    in-out property <bool> show_connect_dialog: false;
    in-out property <bool> show_my_syncs: false;
    in-out property <bool> show_settings: false;
    in-out property <bool> setting_autostart: false;
    in-out property <bool> setting_start_in_tray: true;
    in-out property <string> setting_language: "tr";
    in-out property <bool> show_update_dialog: false;
    in-out property <string> active_sync_code: "";
    // Aktif sync ekranı "Ana Menü" ile gizlendiğinde true olur (sync arka planda sürer, kod kaybolmaz)
    in-out property <bool> active_hidden: false;
    property <bool> active_screen_open: active_sync_code != "" && !active_hidden;
    in-out property <string> active_sync_folder: "";
    in-out property <string> status_text: "";
    in-out property <string> copy_feedback_id: "";
    in-out property <bool> show_quit_dialog: false;
    in-out property <bool> show_delete_dialog: false;
    in-out property <string> delete_target_id: "";
    in-out property <bool> delete_from_cloud: false;
    
    callback confirm_delete_sync(string, bool);


    // --- Callbacks ---
    callback login_requested();
    callback scan_cloud_syncs();
    callback logout_requested();
    callback close_requested();
    callback minimize_requested();
    callback create_new_sync();
    callback connect_to_sync(string /*sync_code*/);
    callback stop_sync(string /*id*/);
    callback copy_to_clipboard(string, string);
    callback open_sync_folder(string /*id*/);
    callback manual_sync_requested(string /*id*/);
    callback fully_quit_requested();
    callback remove_sync_folder(string /*id*/);
    
    callback autostart_toggled(bool);
    callback start_in_tray_toggled(bool);
    callback language_changed(string);
    callback move_window(length /*dx*/, length /*dy*/);


    // ── Pencere sürükleme (frameless pencere için) ─────────────────────────
    // En altta durur; buton/metin/dialog gibi üstündeki öğeler tıklamayı kendisi yakalar,
    // geri kalan her boş alandan pencere sürüklenebilir.
    TouchArea {
        width: 100%;
        height: 100%;
        property <length> press-x;
        property <length> press-y;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            }
        }
        moved => {
            if (self.pressed) {
                root.move_window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    VerticalLayout {
        padding: 15px;

        // ── Custom Titlebar ──────────────────────────────────────
        HorizontalLayout {
            height: 30px;

            // Boş başlık alanı (eskiden burada içi boş bir TouchArea vardı, sürüklemeyi engelliyordu)
            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                IconButton {
                    icon: @image-url("emojis/minimize.svg");
                    clicked => { root.minimize_requested() }
                }
                IconButton {
                    icon: @image-url("emojis/close.svg");
                    clicked => { root.show_quit_dialog = true; }
                }
            }
        }

        // ── Dynamic Top Bar (For lists) ─────────────────────────
        if is_logged_in && show_my_syncs: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                height: 40px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("emojis/back.svg");
                        clicked => { root.show_my_syncs = false; root.error_text = ""; }
                    }
                }

                Text {
                    text: Tr.my_syncs;
                    color: white;
                    font-size: 1.15rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 100px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_scan.pressed ? #74c7ec : (ta_scan.has-hover ? #89dceb : #89b4fa);
                        Text { text: Tr.find_from_cloud; color: #11111b; font-weight: 700; font-size: 0.85rem; horizontal-alignment: center; vertical-alignment: center; }
                        ta_scan := TouchArea { clicked => { root.scan_cloud_syncs() } }
                    }
                }
            }

            // İnce ayırıcı çizgi
            Rectangle { height: 1px; background: #313244; }
        }

        // ── Main Content Area ────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            clip: true;



            // ── Giriş Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (!is_logged_in && !is_logging_in) ? 0 : -self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: white;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: #a6adc8;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                ModernButton {
                    text: Tr.login_google;
                    clicked => { root.login_requested() }
                }
            }

            if !is_logged_in && is_logging_in: VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    VerticalLayout {
                        alignment: center;
                        SmoothSpinner { width: 30px; height: 30px; }
                    }
                    ModernButton {
                        text: Tr.retry;
                        width: 150px;
                        clicked => { root.login_requested() }
                    }
                }
            }

            // ── Ana Ekran (Menü)
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && !show_connect_dialog && !show_my_syncs && !show_settings && !active_screen_open) ? 0 : (show_connect_dialog || show_my_syncs || active_screen_open ? -self.width : self.width);
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: white;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: #a6adc8;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                // Since this uses parent.width, we need to center the buttons manually.
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 260px;
                        spacing: 10px;

                        DarkButton {
                            text: Tr.new_sync;
                            clicked => { root.create_new_sync() }
                        }

                        DarkButton {
                            text: Tr.connect_to_code;
                            clicked => { root.show_connect_dialog = true; root.error_text = ""; }
                        }

                        ModernButton {
                            text: Tr.my_syncs;
                            clicked => { root.show_my_syncs = true; root.error_text = ""; root.scan_cloud_syncs(); }
                        }
                    }
                }
            }

            // ── Aktif Sync Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && active_screen_open) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 20px;

                HorizontalLayout {
                    alignment: center;
                    if root.is_syncing: SmoothSpinner { width: 50px; height: 50px; }
                    if !root.is_syncing: Image { source: @image-url("emojis/check.svg"); width: 48px; height: 48px; colorize: #a6e3a1; }
                }

                Text { text: root.active_sync_folder; font-size: 1.4rem; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                Text { text: root.status_text; font-size: 0.95rem; color: #a6adc8; horizontal-alignment: center; }

                // Kopyala butonu sadece kod hazırsa ve eşitleme bittiyse görünür
                if !root.is_syncing && root.active_sync_code != "pending" && root.active_sync_code != "": VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            width: 160px;
                            height: 36px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: #89b4fa;
                            background: ta_acopy.has-hover ? #1e1e2e : transparent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Image { source: @image-url("emojis/copy.svg"); width: 14px; height: 14px; colorize: #89b4fa; y: 11px; }
                                Text { text: Tr.copy_code; color: #89b4fa; font-weight: 600; font-size: 0.9rem; vertical-alignment: center; }
                            }
                            ta_acopy := TouchArea { clicked => { root.copy_to_clipboard(root.active_sync_code, "active"); } }
                        }
                    }
                    Text {
                        text: Tr.copied;
                        color: #a6e3a1;
                        font-size: 0.85rem;
                        horizontal-alignment: center;
                        opacity: root.copy_feedback_id == "active" ? 1.0 : 0.0;
                        animate opacity { duration: 250ms; }
                    }
                }

                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;
                    ModernButton { text: Tr.main_menu; width: 120px; clicked => { root.active_hidden = true; } }
                    ModernButton { text: Tr.stop_and_delete; width: 120px; clicked => { root.stop_sync(root.active_sync_code); root.active_sync_code = ""; root.active_hidden = false; } }
                }
            }

            // ── Senkronizasyonlarım Listesi
            VerticalLayout {
                width: parent.width; height: parent.height;
                x: (is_logged_in && show_my_syncs) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                if root.sync_folders.length == 0: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 76px;
                            height: 76px;
                            border-radius: 38px;
                            background: #313244;

                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 34px;
                                height: 34px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 3 6 L 10 6 L 12 8.5 L 21 8.5 L 21 19 L 3 19 Z";
                                stroke: #a6adc8;
                                stroke-width: 1.5px;
                            }
                        }
                    }

                    Text {
                        text: Tr.no_syncs_title;
                        color: #cdd6f4;
                        font-size: 1.0rem;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            width: 270px;
                            text: Tr.no_syncs_hint;
                            color: #7f849c;
                            font-size: 0.82rem;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    // Görsel olarak biraz yukarı almak için alt boşluk
                    Rectangle { height: 40px; }
                }

                if root.sync_folders.length > 0: Flickable {
                    width: 100%;
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 10px;
                        for folder in root.sync_folders : HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            Rectangle {
                                background: #313244;
                                border-radius: 8px;
                                height: 64px;

                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        Text { text: folder.name; font-size: 1.0rem; color: #cdd6f4; font-weight: 600; overflow: elide; }
                                        Text { text: folder.path; font-size: 0.75rem; color: #a6adc8; overflow: elide; }
                                        if folder.status != "": Text { text: folder.status; font-size: 0.7rem; color: folder.is_syncing ? #f9e2af : #a6adc8; overflow: elide; }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        if folder.is_syncing: SmoothSpinner { width: 16px; height: 16px; }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 4px;
                                                background: ta_copy.pressed ? #a6e3a1 : (ta_copy.has-hover ? #b4befe : transparent);
                                                Image { source: @image-url("emojis/copy.svg"); width: 16px; height: 16px; colorize: ta_copy.has-hover ? #11111b : #cdd6f4; }
                                                ta_copy := TouchArea {
                                                    clicked => { root.copy_to_clipboard(folder.code, folder.id) }
                                                }
                                            }
                                            Text {
                                                text: Tr.copied;
                                                color: #a6e3a1;
                                                font-size: 0.6rem;
                                                horizontal-alignment: center;
                                                opacity: root.copy_feedback_id == folder.id ? 1.0 : 0.0;
                                                animate opacity { duration: 250ms; }
                                            }
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 4px;
                                            opacity: folder.is_syncing ? 0.35 : 1.0;
                                            background: (!folder.is_syncing && ta_refresh.pressed) ? #a6e3a1 : ((!folder.is_syncing && ta_refresh.has-hover) ? #b4befe : transparent);
                                            Image { source: @image-url("emojis/refresh.svg"); width: 16px; height: 16px; colorize: (!folder.is_syncing && ta_refresh.has-hover) ? #11111b : #cdd6f4; }
                                            ta_refresh := TouchArea {
                                                enabled: !folder.is_syncing;
                                                clicked => { root.manual_sync_requested(folder.id) }
                                            }
                                        }

                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 4px;
                                            background: ta_remove.pressed ? #f38ba8 : (ta_remove.has-hover ? #eba0ac : transparent);
                                            Image { source: @image-url("emojis/trash.svg"); width: 16px; height: 16px; colorize: ta_remove.has-hover ? #11111b : #f38ba8; }
                                            ta_remove := TouchArea {
                                                clicked => { 
                                                    root.delete_target_id = folder.id;
                                                    root.show_delete_dialog = true; 
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Liste altı ayırıcı çizgi + alt çubukla boşluk (ayarlar sayfasıyla aynı)
                if root.sync_folders.length > 0: Rectangle { height: 1px; background: #313244; }
                if root.sync_folders.length > 0: Rectangle { height: 12px; }
            }

            // ── Sync kodu giriş dialogu
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && show_connect_dialog) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    sync_dialog := SyncCodeDialog {
                        confirmed(code) => {
                            root.show_connect_dialog = false; root.error_text = "";
                            root.connect_to_sync(code);
                            sync_dialog.input_code = "";
                        }
                        cancelled => {
                            root.show_connect_dialog = false; root.error_text = "";
                            sync_dialog.input_code = "";
                        }
                    }
                }
            }
        } // End Main Content Area

        // ── Hata barı (Absolute at bottom if needed)
        if root.error_text != "": Rectangle {
            background: #f38ba820;
            border-radius: 4px;
            height: 44px;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.error_text;
                color: #f38ba8;
                font-size: 0.75rem;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            // Tıklayınca kapat
            TouchArea { clicked => { root.error_text = ""; } }
        }

        // ── Absolute Bottom Bar ─────────────────────────────────
        HorizontalLayout {
            height: 20px;
            alignment: space-between;

            // Left side: Çıkış Yap
            HorizontalLayout {
                alignment: start;
                if is_logged_in: Text {
                    text: Tr.logout;
                    color: ta_logout.has-hover ? #f38ba8 : #7f849c;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                    ta_logout := TouchArea { clicked => { root.logout_requested() } }
                }
            }

            // Right side: Status
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                if !root.is_logged_in : HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 60deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 120deg) * 4px; } }
                }

                if root.is_logged_in && !root.is_syncing : Image {
                    source: @image-url("emojis/check.svg");
                    width: 16px;
                    height: 16px;
                    colorize: white;
                }

                if root.is_logged_in && root.is_syncing : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #f9e2af;
                    y: 6px;
                }
                Text {
                    text: root.is_logged_in
                    ? (root.sync_folders.length > 0
                    ? (root.is_syncing ? Tr.status_syncing : Tr.status_connected)
                    : Tr.status_connected)
                    : (root.is_logging_in ? Tr.status_connecting : Tr.status_waiting_login);
                    color: #a6adc8;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                }
            }
        }
    }

        
        // ── Settings Screen ─────────────────────────
        if show_settings: VerticalLayout {
            spacing: 16px;
            padding: 30px;
            padding-bottom: 55px;
            
            HorizontalLayout {
                height: 40px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("emojis/back.svg");
                        clicked => { root.show_settings = false; root.error_text = ""; }
                    }
                }

                Text {
                    text: Tr.settings;
                    color: white;
                    font-size: 1.15rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            
            Rectangle { height: 1px; background: #313244; }

            Flickable {
                width: 100%;
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 16px;
                    alignment: start;
                    padding-bottom: 20px;
                    
                    Text { text: Tr.section_startup; color: #89b4fa; font-size: 1rem; font-weight: 700; }
                    HorizontalLayout {
                        Text { text: Tr.autostart; color: #cdd6f4; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch { 
                            checked <=> root.setting_autostart;
                            toggled => { root.autostart_toggled(root.setting_autostart); } 
                        }
                    }
                    HorizontalLayout {
                        opacity: root.setting_autostart ? 1.0 : 0.5;
                        Text { text: Tr.start_in_tray; color: #a6adc8; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch { 
                            enabled: root.setting_autostart;
                            checked <=> root.setting_start_in_tray;
                            toggled => { root.start_in_tray_toggled(root.setting_start_in_tray); } 
                        }
                    }
                    Rectangle { height: 10px; }

                    Text { text: Tr.section_performance; color: #89b4fa; font-size: 1rem; font-weight: 700; }
                    HorizontalLayout {
                        Text { text: Tr.threads_label; color: #a6adc8; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        LineEdit { text: "4"; width: 60px; }
                    }
                    Text { 
                        text: Tr.threads_hint; 
                        color: #6c7086; font-size: 0.8rem; wrap: word-wrap; 
                    }

                    Rectangle { height: 20px; }

                    HorizontalLayout {
                        Text { text: Tr.language_label; color: #a6adc8; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        ComboBox {
                            width: 120px;
                            height: 30px;
                            model: ["Türkçe", "English", "Deutsch", "Español", "Français", "中文", "한국어", "日本語"];
                            current-value: root.setting_language == "en" ? "English" :
                                           root.setting_language == "de" ? "Deutsch" :
                                           root.setting_language == "es" ? "Español" :
                                           root.setting_language == "fr" ? "Français" :
                                           root.setting_language == "zh" ? "中文" :
                                           root.setting_language == "ko" ? "한국어" :
                                           root.setting_language == "ja" ? "日本語" : "Türkçe";
                            selected(val) => {
                                if (val == "English") { root.language_changed("en"); }
                                else if (val == "Deutsch") { root.language_changed("de"); }
                                else if (val == "Español") { root.language_changed("es"); }
                                else if (val == "Français") { root.language_changed("fr"); }
                                else if (val == "中文") { root.language_changed("zh"); }
                                else if (val == "한국어") { root.language_changed("ko"); }
                                else if (val == "日本語") { root.language_changed("ja"); }
                                else { root.language_changed("tr"); }
                            }
                        }
                    }

                    Rectangle { height: 5px; }
                    Text { text: Tr.section_system; color: #89b4fa; font-size: 1rem; font-weight: 700; }
                    DarkButton {
                        text: Tr.check_updates;
                        clicked => { 
                            // TEST: Popup'i gostermek icin
                            root.show_update_dialog = true; 
                        }
                    }
                }
            }

            // Alttaki kesilme çizgisi (üstteki ayırıcıyla aynı)
            Rectangle { height: 1px; background: #313244; }
        }

        // ── Active Sync Mini Drawer (Right edge) ─────────────────────────
        if (is_syncing && active_hidden && active_sync_code != "" && !show_my_syncs && !show_connect_dialog && !show_settings): Rectangle {
            x: root.width - self.width;
            y: root.height / 2 - self.height / 2;
            width: 48px;
            height: 64px;
            background: #181825cc; // Yari saydam, arka planla uyumlu
            border-top-left-radius: 32px;
            border-bottom-left-radius: 32px;
            border-width: 1px;
            border-color: #313244;
            // Sag kenari cercevesiz gosterip, duvara yapisik hissi vermek icin:
            
            SmoothSpinner {
                x: 12px;
                y: 17px;
            }

            ta_mini := TouchArea {
                clicked => {
                    // Sadece aktif sync ekranını geri getir
                    root.active_hidden = false;
                }
            }
        }


        // ── Update Ready Modal Dialog ─────────────────────────
        
        // ── Delete Sync Modal Dialog ─────────────────────────
        if show_delete_dialog: TouchArea {
            width: 100%;
            height: 100%;
            
            Rectangle {
                width: 100%;
                height: 100%;
                background: #11111b99;
            }
            
            Rectangle {
                width: 320px;
                height: 190px;
                background: #1e1e2e;
                border-radius: 12px;
                border-width: 1px;
                border-color: #313244;
                drop-shadow-blur: 15px;
                drop-shadow-color: #00000080;
                
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;
                    
                    Text { text: Tr.remove_sync_title; font-size: 1.2rem; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                    Text { text: Tr.remove_sync_body; font-size: 0.9rem; color: #a6adc8; horizontal-alignment: center; wrap: word-wrap; }
                    
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Switch { checked <=> root.delete_from_cloud; }
                        Text { text: Tr.delete_from_drive; font-size: 0.85rem; color: #f38ba8; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        
                        Rectangle {
                            width: 110px; height: 36px; border-radius: 18px; border-width: 1px; border-color: #585b70; background: transparent;
                            Text { text: Tr.cancel; color: #cdd6f4; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.show_delete_dialog = false; } }
                        }
                        
                        Rectangle {
                            width: 110px; height: 36px; border-radius: 18px; background: #f38ba8;
                            Text { text: Tr.remove; color: #11111b; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { 
                                root.confirm_delete_sync(root.delete_target_id, root.delete_from_cloud); 
                                root.show_delete_dialog = false; 
                            } }
                        }
                    }
                }
            }
        }

        if show_update_dialog: TouchArea {
            width: 100%;
            height: 100%;
            
            Rectangle {
                width: 100%;
                height: 100%;
                background: #11111b99; // Karartma (Overlay)
            }
            
            Rectangle {
                width: 320px;
                height: 180px;
                background: #1e1e2e;
                border-radius: 12px;
                border-width: 1px;
                border-color: #313244;
                drop-shadow-blur: 15px;
                drop-shadow-color: #00000080;
                
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;
                    
                    Text {
                        text: Tr.update_ready_title;
                        font-size: 1.2rem;
                        color: #cdd6f4;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Tr.update_ready_body;
                        font-size: 0.9rem;
                        color: #a6adc8;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        height: 40px;
                        DarkButton {
                            text: Tr.later;
                            width: 120px;
                            clicked => { root.show_update_dialog = false; }
                        }
                        ModernButton {
                            text: Tr.restart;
                            width: 130px;
                            clicked => { 
                                // root.fully_quit_requested(); // Veya restart event'i
                                root.show_update_dialog = false;
                            }
                        }
                    }
                }
            }
        }


        // ── Floating Settings Button (Ana Ekranda Sağ Üst) ─────────────────────────
        if (is_logged_in && !show_connect_dialog && !show_my_syncs && !show_settings && !active_screen_open): IconButton {
            x: root.width - 45px;
            y: 50px;
            width: 32px;
            height: 32px;
            icon: @image-url("emojis/settings.svg");
            clicked => {
                root.show_settings = true; root.error_text = "";
            }
        }

    // Modal Quit Dialog overlay (en üstte çizilmesi için dosyanın sonunda)
    Rectangle {
        width: 100%;
        height: 100%;
        background: #11111be6;
        opacity: root.show_quit_dialog ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: ease-out; }

        TouchArea {}

        Rectangle {
            width: 320px;
            height: 160px;
            background: #1e1e2e;
            border-radius: 12px;
            border-width: 1px;
            border-color: #313244;

            VerticalLayout {
                padding: 20px;
                spacing: 15px;
                alignment: center;

                Text { text: Tr.quit_title; color: #cdd6f4; font-size: 1.1rem; font-weight: 600; horizontal-alignment: center; }
                Text { text: Tr.quit_body; color: #a6adc8; font-size: 0.85rem; horizontal-alignment: center; }

                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;
                    ModernButton { text: Tr.cancel; width: 100px; clicked => { root.show_quit_dialog = false; } }
                    Rectangle {
                        width: 100px;
                        height: 40px;
                        border-radius: 8px;
                        background: ta_quit.pressed ? #eba0ac : (ta_quit.has-hover ? #f38ba8 : #f38ba8);
                        Text { text: Tr.quit; color: #11111b; font-size: 0.95rem; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        ta_quit := TouchArea { clicked => { root.fully_quit_requested(); } }
                    }
                }
            }
        }
    }
}
