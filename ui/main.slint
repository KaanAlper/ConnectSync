import { Button, VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct SyncFolderItem {
    id: string,
    name: string,
    path: string,
    status: string,
    is_syncing: bool,
    code: string,
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.pressed ? #313244 : (ta.has-hover ? #1e1e2e : transparent);

    if (text != ""): Text {
        text: root.text;
        color: ta.has-hover ? #cdd6f4 : #a6adc8;
        font-size: 1.2rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (text == ""): Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: ta.has-hover ? #cdd6f4 : #a6adc8;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component DarkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? #89b4fa : #45475a;
    background: ta.pressed ? #1e1e2e : (ta.has-hover ? #313244 : #181825);

    Text {
        text: root.text;
        color: #cdd6f4;
        font-weight: 600;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component ModernButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: ta.pressed ? #74c7ec : (ta.has-hover ? #89dceb : #89b4fa);

    Text {
        text: root.text;
        color: #11111b;
        font-weight: 700;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component SmoothSpinner inherits Rectangle {
    width: 30px;
    height: 30px;
    property <angle> rot: 0deg;

    Timer {
        interval: 16ms;
        running: true;
        triggered => { root.rot += 8deg; }
    }

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("spinner.svg");
        transform-rotation: root.rot;
    }
}

component AppLogo inherits Rectangle {
    // scale: 1.0 = orijinal boyut (400x180 kutu), 1.5 = %50 büyük.
    // Resim bu ölçekte çizilir, pencereye sığması için kırpılır (PNG'deki şeffaf boşluk da kırpılır).
    in property <float> scale: 1.25;
    in property <length> box-height: 170px;
    height: root.box-height;
    clip: true;

    Image {
        source: @image-url("../assets/logo.png");
        width: 400px * root.scale;
        height: 180px * root.scale;
        image-fit: contain;
        // -7px: PNG içindeki hafif sağa kaymayı telafi eder
        x: (parent.width - self.width) / 2 - 7px * root.scale;
        y: (parent.height - self.height) / 2;
    }
}

component SyncCodeDialog inherits Rectangle {
    in-out property <string> input_code: "";
    callback confirmed(string);
    callback cancelled();

    width: 320px;
    height: 180px;
    background: #1e1e2e;
    border-radius: 12px;
    border-width: 1px;
    border-color: #313244;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        alignment: center;

        Text {
            text: "Sync Kodunu Girin";
            color: #cdd6f4;
            font-size: 1.1rem;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 40px;
            background: #181825;
            border-radius: 6px;
            border-width: 1px;
            border-color: input.has-focus ? #89b4fa : #313244;

            // Kutunun her yerine tıklayınca odak versin (TextInput'un ALTINDA kalır)
            TouchArea {
                clicked => { input.focus(); }
            }

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.input_code;
                color: #cdd6f4;
                font-size: 0.95rem;
                vertical-alignment: center;
                horizontal-alignment: center;
                single-line: true;

                accepted => { root.confirmed(self.text); }
            }
        }

        HorizontalLayout {
            spacing: 15px;
            alignment: center;
            ModernButton {
                text: "İptal";
                width: 100px;
                clicked => { root.cancelled() }
            }
            ModernButton {
                text: "Bağlan";
                width: 100px;
                clicked => { root.confirmed(root.input_code) }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "ConnectSync";
    width: 400px;
    height: 560px;
    background: #1e1e2e;
    no-frame: true;
    default-font-family: "Segoe UI";

    in-out property <bool> is_logged_in: false;
    in-out property <bool> is_logging_in: false;
    in-out property <string> error_text: "";
    in-out property <[SyncFolderItem]> sync_folders: [];
    in-out property <[SyncFolderItem]> cloud_folders: [];
    in-out property <bool> is_syncing: false;

    // UI state
    in-out property <bool> show_connect_dialog: false;
    in-out property <bool> show_my_syncs: false;
    in-out property <bool> show_settings: false;
    in-out property <string> active_sync_code: "";
    in-out property <string> active_sync_folder: "";
    in-out property <string> status_text: "Hazır";
    in-out property <string> copy_feedback_id: "";
    in-out property <bool> show_quit_dialog: false;

    // --- Callbacks ---
    callback login_requested();
    callback scan_cloud_syncs();
    callback logout_requested();
    callback close_requested();
    callback minimize_requested();
    callback create_new_sync();
    callback connect_to_sync(string /*sync_code*/);
    callback stop_sync(string /*id*/);
    callback copy_to_clipboard(string, string);
    callback open_sync_folder(string /*id*/);
    callback manual_sync_requested(string /*id*/);
    callback fully_quit_requested();
    callback remove_sync_folder(string /*id*/);

    VerticalLayout {
        padding: 15px;

        // ── Custom Titlebar ──────────────────────────────────────
        HorizontalLayout {
            height: 30px;
            alignment: space-between;

            TouchArea {
                width: parent.width - 70px;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                IconButton {
                    text: "⚙";
                    clicked => {
                        root.show_connect_dialog = false;
                        root.show_my_syncs = false;
                        root.show_settings = true;
                    }
                }
                IconButton {
                    text: "_";
                    clicked => { root.minimize_requested() }
                }
                IconButton {
                    text: "X";
                    clicked => { root.show_quit_dialog = true; }
                }
            }
        }

        // ── Dynamic Top Bar (For lists) ─────────────────────────
        if is_logged_in && show_my_syncs: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                height: 40px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("back.svg");
                        clicked => { root.show_my_syncs = false; }
                    }
                }

                Text {
                    text: "Senkronizasyonlarım";
                    color: white;
                    font-size: 1.15rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 100px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_scan.pressed ? #74c7ec : (ta_scan.has-hover ? #89dceb : #89b4fa);
                        Text { text: "Buluttan Bul"; color: #11111b; font-weight: 700; font-size: 0.85rem; horizontal-alignment: center; vertical-alignment: center; }
                        ta_scan := TouchArea { clicked => { root.scan_cloud_syncs() } }
                    }
                }
            }

            // İnce ayırıcı çizgi
            Rectangle { height: 1px; background: #313244; }
        }

        // ── Main Content Area ────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            clip: true;



            // ── Giriş Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (!is_logged_in && !is_logging_in) ? 0 : -self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: white;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: #a6adc8;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                ModernButton {
                    text: "Google Drive ile Giriş Yap";
                    clicked => { root.login_requested() }
                }
            }

            if !is_logged_in && is_logging_in: HorizontalLayout {
                width: parent.width; height: parent.height; alignment: center;
                spacing: 20px;
                SmoothSpinner { width: 30px; height: 30px; }
                ModernButton {
                    text: "Tekrar Dene";
                    width: 150px;
                    clicked => { root.login_requested() }
                }
            }

            // ── Ana Ekran (Menü)
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && !show_connect_dialog && !show_my_syncs && active_sync_code == "") ? 0 : (show_connect_dialog || show_my_syncs || active_sync_code != "" ? -self.width : self.width);
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: white;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: #a6adc8;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                // Since this uses parent.width, we need to center the buttons manually.
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 260px;
                        spacing: 10px;

                        DarkButton {
                            text: "Yeni Bir Sync Klasörü Oluştur";
                            clicked => { root.create_new_sync() }
                        }

                        DarkButton {
                            text: "Bir Sync Koduna Bağlan";
                            clicked => { root.show_connect_dialog = true; }
                        }

                        ModernButton {
                            text: "Senkronizasyonlarım";
                            clicked => { root.show_my_syncs = true; }
                        }
                    }
                }
            }

            // ── Aktif Sync Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && active_sync_code != "") ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 20px;

                HorizontalLayout {
                    alignment: center;
                    if root.is_syncing: SmoothSpinner { width: 50px; height: 50px; }
                    if !root.is_syncing: Text { text: "✓"; font-size: 2.5rem; color: #a6e3a1; horizontal-alignment: center; }
                }

                Text { text: root.active_sync_folder; font-size: 1.4rem; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                Text { text: root.status_text; font-size: 0.95rem; color: #a6adc8; horizontal-alignment: center; }

                // Kopyala butonu sadece kod hazırsa ve eşitleme bittiyse görünür
                if !root.is_syncing && root.active_sync_code != "pending" && root.active_sync_code != "": VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            width: 160px;
                            height: 36px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: #89b4fa;
                            background: ta_acopy.has-hover ? #1e1e2e : transparent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Image { source: @image-url("copy.svg"); width: 14px; height: 14px; colorize: #89b4fa; y: 11px; }
                                Text { text: "Kodu Kopyala"; color: #89b4fa; font-weight: 600; font-size: 0.9rem; vertical-alignment: center; }
                            }
                            ta_acopy := TouchArea { clicked => { root.copy_to_clipboard(root.active_sync_code, "active"); } }
                        }
                    }
                    Text {
                        text: "Kopyalandı!";
                        color: #a6e3a1;
                        font-size: 0.85rem;
                        horizontal-alignment: center;
                        opacity: root.copy_feedback_id == "active" ? 1.0 : 0.0;
                        animate opacity { duration: 250ms; }
                    }
                }

                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;
                    ModernButton { text: "Ana Menü"; width: 120px; clicked => { root.active_sync_code = ""; } }
                    ModernButton { text: "Durdur & Sil"; width: 120px; clicked => { root.stop_sync(root.active_sync_code); root.active_sync_code = ""; } }
                }
            }

            // ── Senkronizasyonlarım Listesi
            VerticalLayout {
                width: parent.width; height: parent.height;
                x: (is_logged_in && show_my_syncs) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                if root.sync_folders.length == 0: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 76px;
                            height: 76px;
                            border-radius: 38px;
                            background: #313244;

                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 34px;
                                height: 34px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 3 6 L 10 6 L 12 8.5 L 21 8.5 L 21 19 L 3 19 Z";
                                stroke: #a6adc8;
                                stroke-width: 1.5px;
                            }
                        }
                    }

                    Text {
                        text: "Henüz bir sync klasörün yok";
                        color: #cdd6f4;
                        font-size: 1.0rem;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            width: 270px;
                            text: "Yeni bir klasör oluştur, bir sync koduna bağlan ya da Drive'daki klasörlerini getirmek için \"Buluttan Bul\"a dokun.";
                            color: #7f849c;
                            font-size: 0.82rem;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    // Görsel olarak biraz yukarı almak için alt boşluk
                    Rectangle { height: 40px; }
                }

                if root.sync_folders.length > 0: ScrollView {
                    width: 100%;
                    VerticalLayout {
                        spacing: 8px;
                        for folder in root.sync_folders : Rectangle {
                            background: #313244;
                            border-radius: 8px;
                            height: 64px;

                            ta_folder := TouchArea {
                                clicked => {
                                    root.active_sync_code = folder.id;
                                    root.active_sync_folder = folder.name;
                                    root.show_my_syncs = false;
                                }
                            }

                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    width: 180px;
                                    Text { text: folder.name; font-size: 1.0rem; color: #cdd6f4; font-weight: 600; overflow: elide; }
                                    Text { text: folder.path; font-size: 0.75rem; color: #a6adc8; overflow: elide; }
                                    if folder.status != "": Text { text: folder.status; font-size: 0.7rem; color: folder.is_syncing ? #f9e2af : #a6adc8; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    if folder.is_syncing: SmoothSpinner { width: 16px; height: 16px; }

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 4px;
                                            background: ta_copy.pressed ? #a6e3a1 : (ta_copy.has-hover ? #b4befe : transparent);
                                            Image { source: @image-url("copy.svg"); width: 16px; height: 16px; colorize: ta_copy.has-hover ? #11111b : #cdd6f4; }
                                            ta_copy := TouchArea {
                                                clicked => { root.copy_to_clipboard(folder.code, folder.id) }
                                            }
                                        }
                                        Text {
                                            text: "Kopyalandı!";
                                            color: #a6e3a1;
                                            font-size: 0.6rem;
                                            horizontal-alignment: center;
                                            opacity: root.copy_feedback_id == folder.id ? 1.0 : 0.0;
                                            animate opacity { duration: 250ms; }
                                        }
                                    }

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 4px;
                                        background: ta_remove.pressed ? #f38ba8 : (ta_remove.has-hover ? #eba0ac : transparent);
                                        Image { source: @image-url("trash.svg"); width: 16px; height: 16px; colorize: ta_remove.has-hover ? #11111b : #f38ba8; }
                                        ta_remove := TouchArea {
                                            clicked => { root.stop_sync(folder.id) }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Sync kodu giriş dialogu
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && show_connect_dialog) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    sync_dialog := SyncCodeDialog {
                        confirmed(code) => {
                            root.show_connect_dialog = false;
                            root.connect_to_sync(code);
                            sync_dialog.input_code = "";
                        }
                        cancelled => {
                            root.show_connect_dialog = false;
                            sync_dialog.input_code = "";
                        }
                    }
                }
            }
        } // End Main Content Area

        // ── Hata barı (Absolute at bottom if needed)
        if root.error_text != "": Rectangle {
            background: #f38ba820;
            border-radius: 4px;
            height: 28px;
            Text {
                text: root.error_text;
                color: #f38ba8;
                font-size: 0.78rem;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ── Absolute Bottom Bar ─────────────────────────────────
        HorizontalLayout {
            height: 20px;
            alignment: space-between;

            // Left side: Çıkış Yap
            HorizontalLayout {
                alignment: start;
                if is_logged_in: Text {
                    text: "Çıkış Yap";
                    color: ta_logout.has-hover ? #f38ba8 : #7f849c;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                    ta_logout := TouchArea { clicked => { root.logout_requested() } }
                }
            }

            // Right side: Status
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                if !root.is_logged_in : HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 60deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 120deg) * 4px; } }
                }

                if root.is_logged_in && !root.is_syncing : Text {
                    text: "✓";
                    color: white;
                    font-size: 1.1rem;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                if root.is_logged_in && root.is_syncing : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #f9e2af;
                    y: 6px;
                }
                Text {
                    text: root.is_logged_in
                    ? (root.sync_folders.length > 0
                    ? (root.is_syncing ? "Eşitleniyor" : "Drive Bağlı")
                    : "Drive Bağlı")
                    : (root.is_logging_in ? "Bağlanıyor..." : "Giriş Bekleniyor");
                    color: #a6adc8;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Modal Quit Dialog overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: #11111be6;
        opacity: root.show_quit_dialog ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; easing: ease-out; }

        TouchArea {}

        Rectangle {
            width: 320px;
            height: 160px;
            background: #1e1e2e;
            border-radius: 12px;
            border-width: 1px;
            border-color: #313244;

            VerticalLayout {
                padding: 20px;
                spacing: 15px;
                alignment: center;

                Text { text: "Kapatmaktan emin misiniz?"; color: #cdd6f4; font-size: 1.1rem; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Uygulama tamamen sonlandırılacak."; color: #a6adc8; font-size: 0.85rem; horizontal-alignment: center; }

                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;
                    ModernButton { text: "İptal"; width: 100px; clicked => { root.show_quit_dialog = false; } }
                    Rectangle {
                        width: 100px;
                        height: 40px;
                        border-radius: 8px;
                        background: ta_quit.pressed ? #eba0ac : (ta_quit.has-hover ? #f38ba8 : #f38ba8);
                        Text { text: "Kapat"; color: #11111b; font-size: 0.95rem; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        ta_quit := TouchArea { clicked => { root.fully_quit_requested(); } }
                    }
                }
            }
        }
    }

        
        // ── Settings Screen ─────────────────────────
        if show_settings: VerticalLayout {
            spacing: 16px;
            padding: 30px;
            alignment: start;
            
            HorizontalLayout {
                alignment: start;
                IconButton {
                    text: "←";
                    clicked => { root.show_settings = false; }
                }
                Text { text: "  Ayarlar"; font-size: 1.4rem; color: #cdd6f4; font-weight: 700; vertical-alignment: center; }
            }
            
            Rectangle { height: 1px; background: #313244; }

            Text { text: "Performans"; color: #89b4fa; font-size: 1rem; font-weight: 700; }
            HorizontalLayout {
                Text { text: "İndirme Parça Sayısı (Concurrent Threads):"; color: #a6adc8; vertical-alignment: center; }
                Rectangle { width: 10px; }
                LineEdit { text: "4"; width: 60px; }
            }
            Text { 
                text: "Yüksek parça sayısı indirmeyi hızlandırır ancak işlemci kullanımını artırır."; 
                color: #6c7086; font-size: 0.8rem; 
            }

            Rectangle { height: 20px; }

            Text { text: "Sistem & Güncelleme"; color: #89b4fa; font-size: 1rem; font-weight: 700; }
            DarkButton {
                text: "Güncellemeleri Denetle";
                clicked => { /* Check for updates */ }
            }
        }

        // ── Active Sync Mini Drawer (Right edge) ─────────────────────────
        if (is_syncing && !show_my_syncs && active_sync_folder != ""): Rectangle {
            x: root.width - self.width;
            y: root.height / 2 - self.height / 2;
            width: 48px;
            height: 64px;
            background: #181825cc; // Yari saydam, arka planla uyumlu
            border-top-left-radius: 32px;
            border-bottom-left-radius: 32px;
            border-width: 1px;
            border-color: #313244;
            // Sag kenari cercevesiz gosterip, duvara yapisik hissi vermek icin:
            
            SmoothSpinner {
                x: 12px;
                y: 17px;
            }

            ta_mini := TouchArea {
                clicked => {
                    // Aktif senkronizasyon klasorunun detayina git veya sync sayfasini ac
                    root.show_my_syncs = true;
                }
            }
        }

}
