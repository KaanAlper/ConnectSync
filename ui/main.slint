import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Çeviri metinleri — değerler Rust tarafında (i18n.rs + locales/*.json) doldurulur
export global Tr {
    out property <string> missing_title: "Klasör Bulunamadı";
    out property <string> missing_upload: "Yeniden Yükle";
    out property <string> missing_remove: "Bağlantıyı Kaldır";

    // Edit Sync
    out property <string> edit_sync_title: "Senkronizasyonu Düzenle";
    out property <string> edit_name: "Klasör Adı:";
    out property <string> edit_path: "Yerel Konum:";
    out property <string> edit_change_path: "Değiştir";
    out property <string> edit_rename_drive: "Drive'da da ismini değiştir";
    out property <string> edit_save: "Kaydet";
    out property <string> edit_sync_btn: "Düzenle";
    in property <string> settings;
    in property <string> section_this_pc: "Bu bilgisayarda aktif olarak eşitlenenler";
    in property <string> section_on_drive: "Drive'da olup bu bilgisayara eklenmemiş olanlar";
    in property <string> not_added_hint: "Henüz bu bilgisayara eklenmedi";
    in property <string> add_from_drive: "Drive'dan Ekle";
    in property <string> my_syncs;
    in property <string> find_from_cloud;
    in property <string> logout;
    in property <string> check_updates;
    in property <string> sync_code_title;
    in property <string> cancel;
    in property <string> connect;
    in property <string> login_google;
    in property <string> retry;
    in property <string> new_sync;
    in property <string> connect_to_code;
    in property <string> copy_code;
    in property <string> copied;
    in property <string> main_menu;
    in property <string> stop_and_delete;
    in property <string> no_syncs_title;
    in property <string> no_syncs_hint;
    in property <string> status_syncing;
    in property <string> status_connected;
    in property <string> status_connecting;
    in property <string> status_waiting_login;
    in property <string> quit_title;
    in property <string> quit_body;
    in property <string> quit;
    in property <string> section_startup;
    in property <string> autostart;
    in property <string> start_in_tray;
    in property <string> section_performance;
    in property <string> threads_label;
    in property <string> threads_hint;
    in property <string> language_label;
    in property <string> section_system;
    in property <string> remove_sync_title;
    in property <string> remove_sync_body;
    in property <string> delete_from_drive;
    in property <string> remove;
    in property <string> update_ready_title;
    in property <string> update_ready_body;
    in property <string> later;
    in property <string> restart;

    in property <string> section_advanced;
    in property <string> watch_changes_label;
    in property <string> watch_changes_hint;
    in property <string> auto_gc_label;
    in property <string> error_popups_label;
    in property <string> network_popups_label;
    in property <string> check_interval_label;
    in property <string> dark_theme_label;
    in property <string> update_now;
    in property <string> ok;
}


component Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled();
    
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: !enabled ? Theme.surface_dim : (checked ? Theme.switch_on : Theme.switch_off);
    animate background { duration: 150ms; }

    // Topuz beyaz: eskiden koyu (#11111b) idi ve yeşil zeminde göz gibi duruyordu.
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? Theme.switch_knob : Theme.switch_knob_off;
        x: checked ? root.width - self.width - 2px : 2px;
        y: 2px;
        animate x { duration: 150ms; easing: ease-in-out; }
    }
    
    TouchArea {
        clicked => { 
            if (root.enabled) { 
                root.checked = !root.checked; 
                root.toggled(); 
            } 
        }
    }
}

// Güncelleme popup'ının durumu (durum makinesi Rust'ta: src/update_ui.rs).
export enum UpdateState { idle, checking, available, downloading, ready, failed, latest }

export struct SyncFolderItem {
    id: string,
    name: string,
    path: string,
    status: string,
    is_syncing: bool,
    code: string,
}

component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: ta.pressed ? Theme.surface : (ta.has-hover ? Theme.bg : transparent);

    if (text != ""): Text {
        text: root.text;
        color: ta.has-hover ? Theme.text : Theme.text_muted;
        font-size: 1.2rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (text == ""): Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: ta.has-hover ? Theme.text : Theme.text_muted;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component DarkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.surface_strong;
    background: ta.pressed ? Theme.bg : (ta.has-hover ? Theme.surface : Theme.bg_deep);

    Text {
        text: root.text;
        color: Theme.text;
        font-weight: 600;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: ta.pressed ? Theme.danger_hover : (ta.has-hover ? Theme.danger_hover : Theme.danger);

    Text {
        text: root.text;
        color: Theme.on_accent;
        font-weight: 700;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component ModernButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: ta.pressed ? Theme.accent_pressed : (ta.has-hover ? Theme.accent_hover : Theme.accent);

    Text {
        text: root.text;
        color: Theme.on_accent;
        font-weight: 700;
        font-size: 0.95rem;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked() }
    }
}

component SmoothSpinner inherits Rectangle {
    width: 30px;
    height: 30px;
    property <angle> rot: 0deg;

    Timer {
        interval: 16ms;
        running: true;
        triggered => { root.rot += 8deg; }
    }

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("emojis/spinner.svg");
        transform-rotation: root.rot;
    }
}

component AppLogo inherits Rectangle {
    // scale: 1.0 = orijinal boyut (400x180 kutu), 1.5 = %50 büyük.
    // Resim bu ölçekte çizilir, pencereye sığması için kırpılır (PNG'deki şeffaf boşluk da kırpılır).
    in property <float> scale: 1.25;
    in property <length> box-height: 170px;
    height: root.box-height;
    clip: true;
    // Açık temada beyaz logo koyu bir plaka üstünde durur; koyu temada plaka görünmez.
    background: Theme.logo_plate;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.logo_plate_border;

    Image {
        source: @image-url("../assets/logo.png");
        width: 400px * root.scale;
        height: 180px * root.scale;
        image-fit: contain;
        // -7px: PNG içindeki hafif sağa kaymayı telafi eder
        x: (parent.width - self.width) / 2 - 7px * root.scale;
        y: (parent.height - self.height) / 2;
    }
}

component SyncCodeDialog inherits Rectangle {
    in-out property <string> input_code: "";
    callback confirmed(string);
    callback cancelled();

    width: 320px;
    height: 180px;
    background: Theme.bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.surface;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;
        alignment: center;

        Text {
            text: Tr.sync_code_title;
            color: Theme.text;
            font-size: 1.1rem;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 40px;
            background: Theme.bg_deep;
            border-radius: 6px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.surface;

            // Kutunun her yerine tıklayınca odak versin (TextInput'un ALTINDA kalır)
            TouchArea {
                clicked => { input.focus(); }
            }

            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.input_code;
                color: Theme.text;
                font-size: 0.95rem;
                vertical-alignment: center;
                horizontal-alignment: center;
                single-line: true;

                accepted => { root.confirmed(self.text); }
            }
        }

        HorizontalLayout {
            spacing: 15px;
            alignment: center;
            ModernButton {
                text: Tr.cancel;
                width: 100px;
                clicked => { root.cancelled() }
            }
            ModernButton {
                text: Tr.connect;
                width: 100px;
                clicked => { root.confirmed(root.input_code) }
            }
        }
    }
}

export component MainWindow inherits Window {
    icon: @image-url("../assets/logo_square.png");
    title: "ConnectSync";
    width: 400px;
    height: 560px;
    background: Theme.bg;
    no-frame: true;
    default-font-family: "Segoe UI";

    forward-focus: fs;


    in-out property <bool> is_logged_in: false;
    in-out property <bool> is_logging_in: false;
    in-out property <string> error_text: "";
    in-out property <[SyncFolderItem]> sync_folders: [];
    in-out property <[SyncFolderItem]> cloud_folders: [];
    in-out property <bool> is_syncing: false;

    // UI state
    in-out property <bool> show_connect_dialog: false;
    in-out property <bool> show_my_syncs: false;
    in-out property <bool> show_settings: false;
    in-out property <bool> this_pc_open: true;
    in-out property <bool> drive_open: true;
    in-out property <bool> setting_autostart: false;
    in-out property <bool> setting_start_in_tray: true;
    in-out property <string> setting_language: "tr";
    in-out property <bool> show_update_dialog: false;
    in-out property <string> active_sync_code: "";
    // Aktif sync ekranı "Ana Menü" ile gizlendiğinde true olur (sync arka planda sürer, kod kaybolmaz)
    in-out property <bool> active_hidden: false;
    property <bool> active_screen_open: active_sync_code != "" && !active_hidden;
    in-out property <string> active_sync_folder: "";
    in-out property <string> status_text: "";
    in-out property <string> copy_feedback_id: "";
    in-out property <bool> show_quit_dialog: false;
    in-out property <bool> show_delete_dialog: false;
    in-out property <bool> show_missing_dialog: false;
    in-out property <string> missing_sync_id: "";

    in-out property <bool> show_edit_dialog: false;
    in-out property <bool> is_creating_new_sync: false;
    in-out property <string> edit_sync_id: "";
    in-out property <string> edit_sync_name: "";
    in-out property <string> edit_sync_path: "";
    in-out property <bool> edit_rename_on_drive: true;
    in-out property <string> missing_sync_body: "";

    in-out property <string> delete_target_id: "";
    in-out property <bool> delete_from_cloud: false;

    // ── İlerleme çubuğu (aktif sync ekranı) ─────────────────────────────
    in-out property <bool> progress_visible: false;
    in-out property <float> progress_fraction: 0.0; // 0.0 - 1.0
    in-out property <string> progress_text: "";
    in-out property <bool> net_warning: false;
    in-out property <string> net_warning_text: "";

    // ── Ek ayarlar ───────────────────────────────────────────────────────
    in-out property <bool> setting_watch_changes: true;
    in-out property <bool> setting_auto_gc: true;
    in-out property <bool> setting_error_popups: true;
    in-out property <bool> setting_network_popups: true;
    in-out property <string> setting_check_interval: "5";
    in-out property <string> setting_threads: "4";
    // Tema: Theme.dark ile çift yönlü (ui/theme.slint). Rust başlangıçta config'ten doldurur.
    in-out property <bool> setting_dark_theme <=> Theme.dark;

    // ── Güncelleme popup'ı (Rust: src/update_ui.rs doldurur) ────────────────
    in-out property <UpdateState> update_state: UpdateState.idle;
    in-out property <string> update_title: "";
    in-out property <string> update_body: "";
    in-out property <float> update_fraction: 0.0; // 0.0 - 1.0
    in-out property <string> update_progress_text: "";

    callback confirm_delete_sync(string, bool);
    callback missing_reupload(string);
    callback missing_remove(string);
    callback missing_upload(string);
    callback edit_sync_save(string, string, string, bool);
    callback new_sync_save(string, string, bool);
    callback edit_pick_path(string);
    callback show_edit_sync(string, string, string);
    show_edit_sync(id, name, path) => {
        root.edit_sync_id = id;
        root.edit_sync_name = name;
        root.edit_sync_path = path;
        root.edit_rename_on_drive = false;
        root.is_creating_new_sync = false;
        root.show_edit_dialog = true;
    }

    callback show_new_sync(string, string);
    show_new_sync(name, path) => {
        root.edit_sync_name = name;
        root.edit_sync_path = path;
        root.edit_rename_on_drive = true;
        root.is_creating_new_sync = true;
        root.show_edit_dialog = true;
    }

    callback watch_changes_toggled(bool);
    callback auto_gc_toggled(bool);
    callback error_popups_toggled(bool);
    callback network_popups_toggled(bool);
    callback check_interval_changed(string);
    callback threads_changed(string);
    callback theme_changed(bool /*dark*/);
    callback check_updates_requested();
    callback update_now_requested();
    callback restart_requested();


    // --- Callbacks ---
    callback login_requested();
    callback scan_cloud_syncs();
    callback logout_requested();
    callback close_requested();
    callback minimize_requested();
    callback create_new_sync();
    callback connect_to_sync(string /*sync_code*/);
    callback stop_sync(string /*id*/);
    callback copy_to_clipboard(string, string);
    callback open_sync_folder(string /*id*/);
    callback manual_sync_requested(string /*id*/);
    callback add_cloud_sync(string, string);
    callback fully_quit_requested();
    callback remove_sync_folder(string /*id*/);
    
    callback autostart_toggled(bool);
    callback start_in_tray_toggled(bool);
    callback language_changed(string);
    callback move_window(length /*dx*/, length /*dy*/);


    // Std widget'lar (LineEdit, ComboBox…) kendi renklerini Palette'ten alır; onları da aynı temaya
    // çek ki koyu pencerede açık kutu (ya da tersi) çıkmasın.
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed setting_dark_theme => {
        Palette.color-scheme = root.setting_dark_theme ? ColorScheme.dark : ColorScheme.light;
    }

    // ── Klavye: Esc = geri / iptal, Enter = popup'ı onayla ────────────────
    // Her iki işlev de en üstteki katmandan başlar: önce popup'lar, sonra ekranlar.
    // Fonksiyonlar tuş yakalayıcıdan ayrı tutuldu; davranış tek yerde okunur.

    /// Esc: en üstteki popup'ı iptal eder ya da bir ekranı ana menüye döndürür.
    /// Bir şey yaptıysa true döner (tuş tüketilir).
    function handle_escape() -> bool {
        if (root.show_quit_dialog) { root.show_quit_dialog = false; return true; }
        if (root.show_delete_dialog) { root.show_delete_dialog = false; return true; }
        if (root.show_missing_dialog) { root.show_missing_dialog = false; return true; }
        if (root.error_text != "") { root.error_text = ""; return true; }
        if (root.show_edit_dialog) { root.show_edit_dialog = false; return true; }
        if (root.show_update_dialog) {
            // İndirme sürerken ve yeniden başlatma beklenirken KAPATILAMAZ. Tuş yine de tüketilir ki
            // arkadaki ekran (ayarlar vb.) Esc ile kapanmasın.
            if (root.update_state == UpdateState.downloading || root.update_state == UpdateState.ready) { return true; }
            root.show_update_dialog = false;
            return true;
        }
        if (root.show_connect_dialog) { root.show_connect_dialog = false; root.error_text = ""; return true; }
        if (root.show_settings) { root.show_settings = false; root.error_text = ""; return true; }
        if (root.show_my_syncs) { root.show_my_syncs = false; root.error_text = ""; return true; }
        // Sync kodu / ilerleme ekranı: "Ana Menü" düğmesiyle aynı (sync arka planda sürer).
        if (root.is_logged_in && root.active_screen_open) { root.active_hidden = true; return true; }
        return false;
    }

    /// Enter bu anda bir popup tarafından tüketilecek mi? (Ayarlardaki LineEdit'lerin
    /// kendi Enter'ı bozulmasın diye popup yokken tuş geçirilir.)
    pure function enter_is_captured() -> bool {
        return root.show_quit_dialog || root.show_delete_dialog || root.show_update_dialog || root.show_missing_dialog || root.error_text != ""
            || (root.is_logged_in && root.show_connect_dialog) || root.show_edit_dialog;
    }

    /// Enter: en üstteki popup'ın onay düğmesiyle aynı işi yapar.
    function handle_enter() {
        if (root.error_text != "") { root.error_text = ""; return; }
        if (root.show_missing_dialog) { root.missing_reupload(root.missing_sync_id); root.show_missing_dialog = false; return; }
        if (root.show_edit_dialog) { return; } // Enter doesn't auto-save, but shouldn't trigger background list
        if (root.show_quit_dialog) { root.fully_quit_requested(); return; }
        if (root.show_delete_dialog) {
            root.confirm_delete_sync(root.delete_target_id, root.delete_from_cloud);
            root.show_delete_dialog = false;
            return;
        }
        if (root.show_update_dialog) {
            // Enter, popup'taki ana düğmeyle aynı işi yapar.
            if (root.update_state == UpdateState.available) { root.update_now_requested(); }
            else if (root.update_state == UpdateState.ready) { root.restart_requested(); }
            else if (root.update_state == UpdateState.failed || root.update_state == UpdateState.latest) {
                root.show_update_dialog = false;
            }
            return;
        }
        // Bağlan popup'ı: boş kodla Enter hiçbir şey yapmaz (kazara kapanmasın).
        if (root.show_connect_dialog && sync_dialog.input_code != "") {
            sync_dialog.confirmed(sync_dialog.input_code);
        }
    }

    // Odaklı öğe yok olunca (popup/ekran kapanınca içindeki LineEdit gibi) odak kaybolur ve
    // Esc/Enter susardı; durum değişince odağı kök yakalayıcıya geri ver. Bağlan popup'ı
    // AÇILIRKEN odağa dokunulmaz (kod kutusuna kullanıcı tıklar).
    changed show_settings => { fs.focus(); }
    changed show_my_syncs => { fs.focus(); }
    changed show_update_dialog => { fs.focus(); }
    changed show_quit_dialog => { fs.focus(); }
    changed show_delete_dialog => { fs.focus(); }
    changed active_hidden => { fs.focus(); }
    changed show_connect_dialog => { if (!root.show_connect_dialog) { fs.focus(); } }

    // Tüm içerik bu FocusScope'un çocuğudur: `capture-key-pressed`, odak hangi öğedeyse (TextInput,
    // LineEdit…) ona ulaşmadan önce ata zincirinde çağrılır. Eskiden kardeş olduğu için odak bir
    // metin kutusundayken Esc hiç gelmiyordu.
    fs := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.handle_escape()) { return accept; }
                return reject;
            }
            if (event.text == Key.Return) {
                if (!root.enter_is_captured()) { return reject; }
                // Enter basılı tutulunca tekrar eden olaylar onayı (silme/çıkış) yeniden tetiklemesin.
                if (!event.repeat) { root.handle_enter(); }
                return accept;
            }
            return reject;
        }

    // ── Pencere sürükleme (frameless pencere için) ─────────────────────────
    // En altta durur; buton/metin/dialog gibi üstündeki öğeler tıklamayı kendisi yakalar,
    // geri kalan her boş alandan pencere sürüklenebilir.
    TouchArea {
        width: 100%;
        height: 100%;
        property <length> press-x;
        property <length> press-y;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
            }
        }
        moved => {
            if (self.pressed) {
                root.move_window(self.mouse-x - self.press-x, self.mouse-y - self.press-y);
            }
        }
    }

    VerticalLayout {
        padding: 15px;

        // ── Custom Titlebar ──────────────────────────────────────
        HorizontalLayout {
            height: 30px;

            // Boş başlık alanı (eskiden burada içi boş bir TouchArea vardı, sürüklemeyi engelliyordu)
            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                IconButton {
                    icon: @image-url("emojis/minimize.svg");
                    clicked => { root.minimize_requested() }
                }
                IconButton {
                    icon: @image-url("emojis/close.svg");
                    clicked => { root.show_quit_dialog = true; }
                }
            }
        }

        // ── Dynamic Top Bar (For lists) ─────────────────────────
        if is_logged_in && show_my_syncs: VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                height: 40px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("emojis/back.svg");
                        clicked => { root.show_my_syncs = false; root.error_text = ""; }
                    }
                }

                Text {
                    text: Tr.my_syncs;
                    color: Theme.text_strong;
                    font-size: 1.15rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 100px;
                        height: 30px;
                        border-radius: 15px;
                        background: ta_scan.pressed ? Theme.accent_pressed : (ta_scan.has-hover ? Theme.accent_hover : Theme.accent);
                        Text { text: Tr.find_from_cloud; color: Theme.on_accent; font-weight: 700; font-size: 0.85rem; horizontal-alignment: center; vertical-alignment: center; }
                        ta_scan := TouchArea { clicked => { root.scan_cloud_syncs() } }
                    }
                }
            }

            // İnce ayırıcı çizgi
            Rectangle { height: 1px; background: Theme.surface; }
        }

        // ── Main Content Area ────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            clip: true;



            // ── Giriş Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (!is_logged_in && !is_logging_in) ? 0 : -self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: Theme.text_strong;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                ModernButton {
                    text: Tr.login_google;
                    clicked => { root.login_requested() }
                }
            }

            if !is_logged_in && is_logging_in: VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                HorizontalLayout {
                    alignment: center;
                    spacing: 20px;
                    VerticalLayout {
                        alignment: center;
                        SmoothSpinner { width: 30px; height: 30px; }
                    }
                    ModernButton {
                        text: Tr.retry;
                        width: 150px;
                        clicked => { root.login_requested() }
                    }
                }
            }

            // ── Ana Ekran (Menü)
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && !show_connect_dialog && !show_my_syncs && !show_settings && !active_screen_open) ? 0 : (show_connect_dialog || show_my_syncs || active_screen_open ? -self.width : self.width);
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                // --- Logo ---
                spacing: 8px;
                AppLogo { }
                Text {
                    text: "ConnectSync";
                    font-size: 1.8rem;
                    font-weight: 700;
                    horizontal-alignment: center;
                    color: Theme.text_strong;
                }
                Text {
                    text: "Serverless Folder Sync";
                    font-size: 1.1rem;
                    color: Theme.text_muted;
                    horizontal-alignment: center;
                }
                Rectangle { height: 12px; }
                // ------------

                // Since this uses parent.width, we need to center the buttons manually.
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 260px;
                        spacing: 10px;

                        DarkButton {
                            text: Tr.new_sync;
                            clicked => { root.create_new_sync() }
                        }

                        DarkButton {
                            text: Tr.connect_to_code;
                            clicked => { root.show_connect_dialog = true; root.error_text = ""; }
                        }

                        ModernButton {
                            text: Tr.my_syncs;
                            clicked => { root.show_my_syncs = true; root.error_text = ""; root.scan_cloud_syncs(); }
                        }
                    }
                }
            }

            // ── Aktif Sync Ekranı
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && active_screen_open) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 20px;

                HorizontalLayout {
                    alignment: center;
                    if root.is_syncing: SmoothSpinner { width: 50px; height: 50px; }
                    if !root.is_syncing: Image { source: @image-url("emojis/check.svg"); width: 48px; height: 48px; colorize: Theme.ok; }
                }

                Text { text: root.active_sync_folder; font-size: 1.4rem; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
                Text { text: root.status_text; font-size: 0.95rem; color: Theme.text_muted; horizontal-alignment: center; }

                // ── XDM/IDM tarzı MB/GB ilerleme çubuğu ─────────────────
                if root.progress_visible: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 260px;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.surface;
                            clip: true;
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * (root.progress_fraction < 0.02 ? 0.02 : root.progress_fraction);
                                height: parent.height;
                                border-radius: 5px;
                                background: root.net_warning ? Theme.warn : Theme.accent;
                                animate width { duration: 200ms; easing: ease-out; }
                            }
                        }
                    }
                    Text {
                        text: root.progress_text;
                        font-size: 0.75rem;
                        color: Theme.text_dim;
                        horizontal-alignment: center;
                    }
                }

                // ── Bağlantı kopukluğu uyarısı ──────────────────────────
                if root.net_warning: HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.warn;
                        y: 4px;
                    }
                    Text {
                        text: root.net_warning_text;
                        font-size: 0.78rem;
                        color: Theme.warn_text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        width: 250px;
                    }
                }

                // Kopyala butonu sadece kod hazırsa ve eşitleme bittiyse görünür
                if !root.is_syncing && root.active_sync_code != "pending" && root.active_sync_code != "": VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Rectangle {
                            width: 160px;
                            height: 36px;
                            border-radius: 18px;
                            border-width: 1px;
                            border-color: Theme.accent;
                            background: ta_acopy.has-hover ? Theme.bg : transparent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Image { source: @image-url("emojis/copy.svg"); width: 14px; height: 14px; colorize: Theme.accent; y: 11px; }
                                Text { text: Tr.copy_code; color: Theme.accent; font-weight: 600; font-size: 0.9rem; vertical-alignment: center; }
                            }
                            ta_acopy := TouchArea { clicked => { root.copy_to_clipboard(root.active_sync_code, "active"); } }
                        }
                    }
                    Text {
                        text: Tr.copied;
                        color: Theme.ok_text;
                        font-size: 0.85rem;
                        horizontal-alignment: center;
                        opacity: root.copy_feedback_id == "active" ? 1.0 : 0.0;
                        animate opacity { duration: 250ms; }
                    }
                }

                HorizontalLayout {
                    spacing: 15px;
                    alignment: center;
                    ModernButton { text: Tr.main_menu; width: 120px; clicked => { root.active_hidden = true; } }
                    ModernButton { text: Tr.stop_and_delete; width: 120px; clicked => { root.stop_sync(root.active_sync_code); root.active_sync_code = ""; root.active_hidden = false; } }
                }
            }

            // ── Senkronizasyonlarım Listesi
            VerticalLayout {
                width: parent.width; height: parent.height;
                x: (is_logged_in && show_my_syncs) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                if root.sync_folders.length == 0: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 76px;
                            height: 76px;
                            border-radius: 38px;
                            background: Theme.surface;

                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 34px;
                                height: 34px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M 3 6 L 10 6 L 12 8.5 L 21 8.5 L 21 19 L 3 19 Z";
                                stroke: Theme.text_muted;
                                stroke-width: 1.5px;
                            }
                        }
                    }

                    Text {
                        text: Tr.no_syncs_title;
                        color: Theme.text;
                        font-size: 1.0rem;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            width: 270px;
                            text: Tr.no_syncs_hint;
                            color: Theme.text_dim;
                            font-size: 0.82rem;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    // Görsel olarak biraz yukarı almak için alt boşluk
                    Rectangle { height: 40px; }
                }

                if root.sync_folders.length > 0 || root.cloud_folders.length > 0: ScrollView {


                    width: 100%;


                    vertical-stretch: 1;


                    VerticalLayout {


                        alignment: start;


                        spacing: 8px;


                        padding-top: 12px;


                        padding-bottom: 10px;



                        // ── Bölüm 1: Bu bilgisayarda aktif olarak eşitlenenler (aç/kapa)


                        if root.sync_folders.length > 0: Rectangle {


                            height: 34px;


                            HorizontalLayout {


                                padding-left: 22px;


                                padding-right: 20px;


                                spacing: 8px;


                                Text { text: Tr.section_this_pc; color: Theme.accent; font-size: 1.05rem; font-weight: 700; vertical-alignment: center; overflow: elide; }


                                VerticalLayout {


                                    alignment: center;


                                    Path {


                                        width: 14px;


                                        height: 14px;


                                        viewbox-width: 24;


                                        viewbox-height: 24;


                                        commands: "M 5 9 L 12 16 L 19 9";


                                        stroke: Theme.accent;


                                        stroke-width: 2.5px;


                                        transform-rotation: root.this_pc_open ? 0deg : -90deg;


                                        animate transform-rotation { duration: 300ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }


                                    }


                                }


                                Rectangle { horizontal-stretch: 1; }


                            }


                            TouchArea { clicked => { root.this_pc_open = !root.this_pc_open; } }


                        }


                        


                        Rectangle {


                            clip: true;


                            property <length> content-h: root.sync_folders.length > 0 ? (root.sync_folders.length * 64px + (root.sync_folders.length - 1) * 8px) : 0px;


                            height: root.this_pc_open ? self.content-h : 0px;


                            animate height { duration: 300ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }



                            VerticalLayout {


                                height: parent.content-h;


                                spacing: 8px;


                                for folder in root.sync_folders : HorizontalLayout {


                                    padding-left: 20px;


                                    padding-right: 20px;


                                    Rectangle {


                                        background: Theme.surface;


                                        border-radius: 8px;


                                        height: 64px;



                                        HorizontalLayout {


                                            padding: 10px;


                                            spacing: 10px;


                                            VerticalLayout {


                                                alignment: center;


                                                horizontal-stretch: 1;


                                                min-width: 0px;


                                                Text { text: folder.name; font-size: 1.0rem; color: Theme.text; font-weight: 600; overflow: elide; }


                                                Text { text: folder.path; font-size: 0.75rem; color: Theme.text_muted; overflow: elide; }


                                                if folder.status != "": Text { text: folder.status; font-size: 0.7rem; color: folder.is_syncing ? Theme.warn_text : Theme.text_muted; overflow: elide; }


                                            }


                                            HorizontalLayout {


                                                alignment: center;


                                                spacing: 8px;


                                                if folder.is_syncing: SmoothSpinner { width: 16px; height: 16px; }



                                                VerticalLayout {


                                                    alignment: center;


                                                    Rectangle {


                                                        width: 32px;


                                                        height: 32px;


                                                        border-radius: 4px;


                                                        background: ta_copy.pressed ? Theme.ok : (ta_copy.has-hover ? Theme.lavender : transparent);


                                                        Image { source: @image-url("emojis/copy.svg"); width: 16px; height: 16px; colorize: ta_copy.has-hover ? Theme.on_accent : Theme.text; }


                                                        ta_copy := TouchArea {


                                                            clicked => { root.copy_to_clipboard(folder.code, folder.id) }


                                                        }


                                                    }


                                                    Text {


                                                        text: Tr.copied;


                                                        color: Theme.ok_text;


                                                        font-size: 0.6rem;


                                                        horizontal-alignment: center;


                                                        opacity: root.copy_feedback_id == folder.id ? 1.0 : 0.0;


                                                        animate opacity { duration: 250ms; }


                                                    }


                                                }



                                                Rectangle {


                                                    width: 32px;


                                                    height: 32px;


                                                    border-radius: 4px;


                                                    opacity: folder.is_syncing ? 0.35 : 1.0;


                                                    background: (!folder.is_syncing && ta_refresh.pressed) ? Theme.ok : ((!folder.is_syncing && ta_refresh.has-hover) ? Theme.lavender : transparent);


                                                    Image { source: @image-url("emojis/refresh.svg"); width: 16px; height: 16px; colorize: (!folder.is_syncing && ta_refresh.has-hover) ? Theme.on_accent : Theme.text; }


                                                    ta_refresh := TouchArea {


                                                        enabled: !folder.is_syncing;


                                                        clicked => { root.manual_sync_requested(folder.id) }


                                                    }


                                                }



                                                Rectangle {


                                                    width: 32px;


                                                    height: 32px;


                                                    border-radius: 4px;


                                                    background: ta_remove.pressed ? Theme.danger : (ta_remove.has-hover ? Theme.danger_hover : transparent);


                                                    Image { source: @image-url("emojis/trash.svg"); width: 16px; height: 16px; colorize: ta_remove.has-hover ? Theme.on_accent : Theme.danger; }


                                                    ta_remove := TouchArea {


                                                        clicked => { 


                                                            root.delete_target_id = folder.id;


                                                            root.show_delete_dialog = true; 


                                                        }


                                                    }


                                                }


                                            }


                                        }


                                    }


                                }


                            }


                        }



                        // ── Bölüm 2: Drive'da olup bu bilgisayara eklenmemiş olanlar (aç/kapa)


                        if root.sync_folders.length > 0 && root.cloud_folders.length > 0: Rectangle { height: 6px; }


                        if root.cloud_folders.length > 0: Rectangle {


                            height: 34px;


                            HorizontalLayout {


                                padding-left: 22px;


                                padding-right: 20px;


                                spacing: 8px;


                                Text { text: Tr.section_on_drive; color: Theme.accent; font-size: 1.05rem; font-weight: 700; vertical-alignment: center; overflow: elide; }


                                VerticalLayout {


                                    alignment: center;


                                    Path {


                                        width: 14px;


                                        height: 14px;


                                        viewbox-width: 24;


                                        viewbox-height: 24;


                                        commands: "M 5 9 L 12 16 L 19 9";


                                        stroke: Theme.accent;


                                        stroke-width: 2.5px;


                                        transform-rotation: root.drive_open ? 0deg : -90deg;


                                        animate transform-rotation { duration: 300ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }


                                    }


                                }


                                Rectangle { horizontal-stretch: 1; }


                            }


                            TouchArea { clicked => { root.drive_open = !root.drive_open; } }


                        }


                        


                        Rectangle {


                            clip: true;


                            property <length> content-h: root.cloud_folders.length > 0 ? (root.cloud_folders.length * 64px + (root.cloud_folders.length - 1) * 8px) : 0px;


                            height: root.drive_open ? self.content-h : 0px;


                            animate height { duration: 300ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }



                            VerticalLayout {


                                height: parent.content-h;


                                spacing: 8px;


                                for cf in root.cloud_folders : HorizontalLayout {


                                    padding-left: 20px;


                                    padding-right: 20px;


                                    Rectangle {


                                        background: Theme.bg_raised;


                                        border-radius: 8px;


                                        border-width: 1px;


                                        border-color: Theme.surface_strong;


                                        height: 64px;



                                        HorizontalLayout {


                                            padding: 10px;


                                            spacing: 10px;


                                            VerticalLayout {


                                                alignment: center;


                                                horizontal-stretch: 1;


                                                min-width: 0px;


                                                Text { text: cf.name; font-size: 1.0rem; color: Theme.text; font-weight: 600; overflow: elide; }


                                                Text { text: Tr.not_added_hint; font-size: 0.72rem; color: Theme.text_dim; overflow: elide; }


                                            }


                                            VerticalLayout {


                                                alignment: center;


                                                Rectangle {


                                                    height: 32px;


                                                    border-radius: 6px;


                                                    background: ta_add.pressed ? Theme.ok : (ta_add.has-hover ? Theme.lavender : Theme.accent);


                                                    HorizontalLayout {


                                                        padding-left: 12px;


                                                        padding-right: 12px;


                                                        Text { text: Tr.add_from_drive; color: Theme.on_accent; font-size: 0.8rem; font-weight: 700; vertical-alignment: center; }


                                                    }


                                                    ta_add := TouchArea {


                                                        clicked => { root.add_cloud_sync(cf.code, cf.name) }


                                                    }


                                                }


                                            }


                                        }


                                    }


                                }


                            }


                        }


                    }


                }



                // Liste altı ayırıcı çizgi + alt çubukla boşluk (ayarlar sayfasıyla aynı)


                if root.sync_folders.length > 0 || root.cloud_folders.length > 0: Rectangle { height: 1px; background: Theme.surface; }


                if root.sync_folders.length > 0 || root.cloud_folders.length > 0: Rectangle { height: 12px; }
            }

            // ── Sync kodu giriş dialogu
            VerticalLayout {
                width: parent.width; height: parent.height; alignment: center;
                x: (is_logged_in && show_connect_dialog) ? 0 : self.width;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                spacing: 10px;

                HorizontalLayout {
                    alignment: center;
                    sync_dialog := SyncCodeDialog {
                        confirmed(code) => {
                            root.show_connect_dialog = false; root.error_text = "";
                            root.connect_to_sync(code);
                            sync_dialog.input_code = "";
                        }
                        cancelled => {
                            root.show_connect_dialog = false; root.error_text = "";
                            sync_dialog.input_code = "";
                        }
                    }
                }
            }
        } // End Main Content Area


        // ── Absolute Bottom Bar ─────────────────────────────────
        HorizontalLayout {
            height: 20px;
            alignment: space-between;

            // Left side: Çıkış Yap
            HorizontalLayout {
                alignment: start;
                if is_logged_in: Text {
                    text: Tr.logout;
                    color: ta_logout.has-hover ? Theme.danger : Theme.text_dim;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                    ta_logout := TouchArea { clicked => { root.logout_requested() } }
                }
            }

            // Right side: Status
            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                if !root.is_logged_in : HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 60deg) * 4px; } }
                    Rectangle { width: 5px; height: 15px; Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: white; y: 5px + sin(animation-tick() / 1s * 360deg - 120deg) * 4px; } }
                }

                if root.is_logged_in && !root.is_syncing : Image {
                    source: @image-url("emojis/check.svg");
                    width: 16px;
                    height: 16px;
                    colorize: white;
                }

                if root.is_logged_in && root.is_syncing : Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.warn;
                    y: 6px;
                }
                Text {
                    text: root.is_logged_in
                    ? (root.sync_folders.length > 0
                    ? (root.is_syncing ? Tr.status_syncing : Tr.status_connected)
                    : Tr.status_connected)
                    : (root.is_logging_in ? Tr.status_connecting : Tr.status_waiting_login);
                    color: Theme.text_muted;
                    font-size: 0.85rem;
                    vertical-alignment: center;
                }
            }
        }
    }

        
        // ── Settings Screen ─────────────────────────
        if show_settings: VerticalLayout {
            spacing: 16px;
            padding: 30px;
            padding-bottom: 55px;
            
            HorizontalLayout {
                height: 40px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("emojis/back.svg");
                        clicked => { root.show_settings = false; root.error_text = ""; }
                    }
                }

                Text {
                    text: Tr.settings;
                    color: Theme.text_strong;
                    font-size: 1.15rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            
            Rectangle { height: 1px; background: Theme.surface; }

            Flickable {
                width: 100%;
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 16px;
                    alignment: start;
                    padding-bottom: 20px;
                    
                    Text { text: Tr.section_startup; color: Theme.accent; font-size: 1rem; font-weight: 700; }
                    HorizontalLayout {
                        Text { text: Tr.autostart; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch { 
                            checked <=> root.setting_autostart;
                            toggled => { root.autostart_toggled(root.setting_autostart); } 
                        }
                    }
                    HorizontalLayout {
                        opacity: root.setting_autostart ? 1.0 : 0.6;
                        Text { text: Tr.start_in_tray; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch { 
                            enabled: root.setting_autostart;
                            checked <=> root.setting_start_in_tray;
                            toggled => { root.start_in_tray_toggled(root.setting_start_in_tray); } 
                        }
                    }
                    Rectangle { height: 10px; }

                    Text { text: Tr.section_performance; color: Theme.accent; font-size: 1rem; font-weight: 700; }
                    HorizontalLayout {
                        Text { text: Tr.threads_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        LineEdit {
                            text <=> root.setting_threads;
                            width: 60px;
                            accepted => { root.threads_changed(self.text); }
                        }
                    }
                    Text { 
                        text: Tr.threads_hint; 
                        color: Theme.text_faint; font-size: 0.8rem; wrap: word-wrap; 
                    }

                    Rectangle { height: 20px; }

                    HorizontalLayout {
                        Text { text: Tr.language_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        ComboBox {
                            width: 120px;
                            height: 30px;
                            model: ["Türkçe", "English", "Deutsch", "Español", "Français", "中文", "한국어", "日本語"];
                            current-value: root.setting_language == "en" ? "English" :
                                           root.setting_language == "de" ? "Deutsch" :
                                           root.setting_language == "es" ? "Español" :
                                           root.setting_language == "fr" ? "Français" :
                                           root.setting_language == "zh" ? "中文" :
                                           root.setting_language == "ko" ? "한국어" :
                                           root.setting_language == "ja" ? "日本語" : "Türkçe";
                            selected(val) => {
                                if (val == "English") { root.language_changed("en"); }
                                else if (val == "Deutsch") { root.language_changed("de"); }
                                else if (val == "Español") { root.language_changed("es"); }
                                else if (val == "Français") { root.language_changed("fr"); }
                                else if (val == "中文") { root.language_changed("zh"); }
                                else if (val == "한국어") { root.language_changed("ko"); }
                                else if (val == "日本語") { root.language_changed("ja"); }
                                else { root.language_changed("tr"); }
                            }
                        }
                    }

                    HorizontalLayout {
                        Text { text: Tr.dark_theme_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch {
                            checked <=> root.setting_dark_theme;
                            toggled => { root.theme_changed(root.setting_dark_theme); }
                        }
                    }

                    Rectangle { height: 5px; }
                    Text { text: Tr.section_advanced; color: Theme.accent; font-size: 1rem; font-weight: 700; }

                    HorizontalLayout {
                        Text { text: Tr.watch_changes_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch {
                            checked <=> root.setting_watch_changes;
                            toggled => { root.watch_changes_toggled(root.setting_watch_changes); }
                        }
                    }
                    Text { text: Tr.watch_changes_hint; color: Theme.text_faint; font-size: 0.8rem; wrap: word-wrap; }

                    HorizontalLayout {
                        Text { text: Tr.check_interval_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        LineEdit {
                            text <=> root.setting_check_interval;
                            width: 60px;
                            accepted => { root.check_interval_changed(self.text); }
                        }
                    }

                    HorizontalLayout {
                        Text { text: Tr.auto_gc_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch {
                            checked <=> root.setting_auto_gc;
                            toggled => { root.auto_gc_toggled(root.setting_auto_gc); }
                        }
                    }

                    HorizontalLayout {
                        Text { text: Tr.error_popups_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch {
                            checked <=> root.setting_error_popups;
                            toggled => { root.error_popups_toggled(root.setting_error_popups); }
                        }
                    }

                    HorizontalLayout {
                        opacity: root.setting_error_popups ? 1.0 : 0.6;
                        Text { text: Tr.network_popups_label; color: Theme.text; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        Rectangle { width: 10px; }
                        Switch {
                            enabled: root.setting_error_popups;
                            checked <=> root.setting_network_popups;
                            toggled => { root.network_popups_toggled(root.setting_network_popups); }
                        }
                    }

                    Rectangle { height: 5px; }
                    Text { text: Tr.section_system; color: Theme.accent; font-size: 1rem; font-weight: 700; }
                    DarkButton {
                        text: Tr.check_updates;
                        clicked => {
                            root.show_update_dialog = true;
                            root.check_updates_requested();
                        }
                    }
                }
            }

            // Alttaki kesilme çizgisi (üstteki ayırıcıyla aynı)
            Rectangle { height: 1px; background: Theme.surface; }
        }

        // ── Active Sync Mini Drawer (Right edge) ─────────────────────────
        if (is_syncing && active_hidden && active_sync_code != "" && !show_my_syncs && !show_connect_dialog && !show_settings): Rectangle {
            x: root.width - self.width;
            y: root.height / 2 - self.height / 2;
            width: 48px;
            height: 64px;
            background: Theme.panel_glass; // Yari saydam, arka planla uyumlu
            border-top-left-radius: 32px;
            border-bottom-left-radius: 32px;
            border-width: 1px;
            border-color: Theme.surface;
            // Sag kenari cercevesiz gosterip, duvara yapisik hissi vermek icin:
            
            SmoothSpinner {
                x: 12px;
                y: 17px;
            }

            ta_mini := TouchArea {
                clicked => {
                    // Sadece aktif sync ekranını geri getir
                    root.active_hidden = false;
                }
            }
        }


        // ── Update Ready Modal Dialog ─────────────────────────
        
        // ── Delete Sync Modal Dialog ─────────────────────────
        if show_delete_dialog: TouchArea {
        scroll-event(event) => { return accept; }
            width: 100%;
            height: 100%;

            Rectangle {
                width: 100%; height: 100%; background: Theme.scrim_strong;
                opacity: root.show_delete_dialog ? 1.0 : 0.0;
                animate opacity { duration: 200ms; easing: ease-out; }
            }

            Rectangle {
                width: 320px;
                height: delete_content.preferred-height;
                background: Theme.bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface;
                drop-shadow-blur: 15px;
                drop-shadow-color: Theme.shadow;

                delete_content := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;

                    Text { text: Tr.remove_sync_title; font-size: 1.2rem; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: Tr.remove_sync_body; font-size: 0.9rem; color: Theme.text_muted; horizontal-alignment: center; wrap: word-wrap; }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        Switch { checked <=> root.delete_from_cloud; }
                        Text { text: Tr.delete_from_drive; font-size: 0.85rem; color: Theme.danger; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        height: 40px;
                        DarkButton {
                            text: Tr.cancel;
                            width: 120px;
                            clicked => { root.show_delete_dialog = false; }
                        }
                        DangerButton {
                            text: Tr.remove;
                            width: 130px;
                            clicked => { 
                                root.confirm_delete_sync(root.delete_target_id, root.delete_from_cloud); 
                                root.show_delete_dialog = false; 
                            }
                        }
                    }
                }
            }
        }

        // ── Güncelleme popup'ı ───────────────────────────────────────────────
        // Durumlar: checking → available → downloading → ready | failed; ayrıca latest.
        // İndirirken ve "yeniden başlat" beklerken Esc kapatmaz (bkz. handle_escape).
        if show_update_dialog: TouchArea {
        scroll-event(event) => { return accept; }
            width: 100%;
            height: 100%;

            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.scrim;
            }

            Rectangle {
                width: 320px;
                height: update_content.preferred-height;
                background: Theme.bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface;
                drop-shadow-blur: 15px;
                drop-shadow-color: Theme.shadow;

                update_content := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;

                    if root.update_state == UpdateState.checking || root.update_state == UpdateState.downloading: HorizontalLayout {
                        alignment: center;
                        SmoothSpinner { }
                    }

                    Text {
                        text: root.update_title;
                        font-size: 1.2rem;
                        color: Theme.text;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.update_body != "": Text {
                        text: root.update_body;
                        font-size: 0.9rem;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // İndirme çubuğu (eşitleme ilerleme çubuğuyla aynı görünüm)
                    if root.update_state == UpdateState.downloading: VerticalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.surface;
                            Rectangle {
                                x: 0px;
                                height: parent.height;
                                width: parent.width * (root.update_fraction < 0.02 ? 0.02 : root.update_fraction);
                                border-radius: 4px;
                                background: Theme.accent;
                                animate width { duration: 150ms; }
                            }
                        }
                        Text {
                            text: root.update_progress_text;
                            font-size: 0.8rem;
                            color: Theme.text_faint;
                            horizontal-alignment: center;
                        }
                    }

                    if root.update_state == UpdateState.available: HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        height: 40px;
                        DarkButton {
                            text: Tr.later;
                            width: 120px;
                            clicked => { root.show_update_dialog = false; }
                        }
                        ModernButton {
                            text: Tr.update_now;
                            width: 130px;
                            clicked => { root.update_now_requested(); }
                        }
                    }
                    if root.update_state == UpdateState.ready: HorizontalLayout {
                        alignment: center;
                        height: 40px;
                        ModernButton {
                            text: Tr.restart;
                            width: 170px;
                            clicked => { root.restart_requested(); }
                        }
                    }
                    if root.update_state == UpdateState.failed || root.update_state == UpdateState.latest: HorizontalLayout {
                        alignment: center;
                        height: 40px;
                        ModernButton {
                            text: Tr.ok;
                            width: 120px;
                            clicked => { root.show_update_dialog = false; }
                        }
                    }
                }
            }
        }

        // ── Floating Settings Button (Ana Ekranda Sağ Üst) ─────────────────────────
        if (is_logged_in && !show_connect_dialog && !show_my_syncs && !show_settings && !active_screen_open): IconButton {
            x: root.width - 45px;
            y: 50px;
            width: 32px;
            height: 32px;
            icon: @image-url("emojis/settings.svg");
            clicked => {
                root.show_settings = true; root.error_text = "";
            }
        }

        // ── Hata Modal Dialog ─────────────────────────
        if root.error_text != "": TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(event) => { return accept; }

            Rectangle {
                width: 100%; height: 100%; background: Theme.scrim_strong;
                opacity: root.error_text != "" ? 1.0 : 0.0;
                animate opacity { duration: 200ms; easing: ease-out; }
            }

            Rectangle {
                width: 380px;
                height: err_content.preferred-height;
                background: Theme.bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface;
                drop-shadow-blur: 15px;
                drop-shadow-color: Theme.shadow;

                err_content := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;

                    Text { text: "Hata"; font-size: 1.2rem; font-weight: 700; color: Theme.danger; horizontal-alignment: center; }
                    
                    Rectangle { height: 1px; width: 100%; background: Theme.surface; }

                    Rectangle {
                        width: 100%;
                        height: 140px;
                        background: transparent;

                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: err_text.preferred-height + 24px;
                            interactive: true;

                            err_text := Text {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                text: root.error_text;
                                color: Theme.text_muted;
                                font-size: 0.85rem;
                                wrap: word-wrap;
                                horizontal-alignment: left;
                            }
                        }
                    }

                    Rectangle { height: 1px; width: 100%; background: Theme.surface; }

                    HorizontalLayout {
                        alignment: center;
                        height: 40px;
                        ModernButton {
                            text: Tr.ok;
                            width: 120px;
                            clicked => { root.error_text = ""; }
                        }
                    }
                }
            }
        }

        // ── Missing Sync Modal Dialog ─────────────────────────
        if show_missing_dialog: TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(event) => { return accept; }

            Rectangle {
                width: 100%; height: 100%; background: Theme.scrim_strong;
                opacity: root.show_missing_dialog ? 1.0 : 0.0;
                animate opacity { duration: 200ms; easing: ease-out; }
            }

            Rectangle {
                width: 380px;
                height: missing_content.preferred-height;
                background: Theme.bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface;
                drop-shadow-blur: 15px;
                drop-shadow-color: Theme.shadow;

                missing_content := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: center;

                    Text { text: Tr.missing_title; font-size: 1.2rem; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: root.missing_sync_body; font-size: 0.9rem; color: Theme.text_muted; horizontal-alignment: center; wrap: word-wrap; }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        height: 40px;
                        ModernButton {
                            text: Tr.missing_upload;
                            width: 140px;
                            clicked => { 
                                root.missing_upload(root.missing_sync_id); 
                                root.show_missing_dialog = false; 
                            }
                        }
                        DangerButton {
                            text: Tr.missing_remove;
                            width: 140px;
                            clicked => { 
                                root.missing_remove(root.missing_sync_id); 
                                root.show_missing_dialog = false; 
                            }
                        }
                    }
                }
            }
        }

        // ── Edit Sync Modal Dialog ─────────────────────────
        if show_edit_dialog: TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(event) => { return accept; }

            Rectangle {
                width: 100%; height: 100%; background: Theme.scrim_strong;
                opacity: root.show_edit_dialog ? 1.0 : 0.0;
                animate opacity { duration: 200ms; easing: ease-out; }
            }

            Rectangle {
                width: 380px;
                height: edit_content.preferred-height;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface;
                drop-shadow-blur: 15px;
                drop-shadow-color: Theme.shadow;

                edit_content := VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    Text { text: Tr.edit_sync_title; font-size: 1.2rem; font-weight: 700; color: Theme.text; wrap: word-wrap; }

                    // Name
                    Text { text: Tr.edit_name; font-size: 0.9rem; color: Theme.text_muted; }
                    Rectangle {
                        height: 40px;
                        background: Theme.bg;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border_strong;
                        TextInput {
                            text <=> root.edit_sync_name;
                            color: Theme.text;
                            font-size: 1rem;
                            vertical-alignment: center;
                            x: 12px;
                            width: parent.width - 24px;
                        }
                    }

                    // Path
                    Text { text: Tr.edit_path; font-size: 0.9rem; color: Theme.text_muted; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 40px;
                            background: Theme.bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border_strong;
                            Text {
                                text: root.edit_sync_path;
                                color: Theme.text_muted;
                                font-size: 0.9rem;
                                vertical-alignment: center;
                                x: 12px;
                                width: parent.width - 24px;
                                overflow: elide;
                            }
                        }
                        DarkButton {
                            text: Tr.edit_change_path;
                            width: 80px;
                            clicked => { root.edit_pick_path(root.edit_sync_id); }
                        }
                    }

                    // Rename on Drive toggle
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Switch {
                            checked <=> root.edit_rename_on_drive;
                        }
                        Text {
                            text: Tr.edit_rename_drive;
                            color: Theme.text;
                            font-size: 0.95rem;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { height: 8px; } // spacer

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: center;
                        height: 40px;
                        DarkButton {
                            text: Tr.cancel;
                            width: 120px;
                            clicked => { root.show_edit_dialog = false; }
                        }
                        ModernButton {
                            text: Tr.edit_save;
                            width: 120px;
                            clicked => { 
                                root.edit_sync_save(root.edit_sync_id, root.edit_sync_name, root.edit_sync_path, root.edit_rename_on_drive); 
                                root.show_edit_dialog = false; 
                            }
                        }
                    }
                }
            }
        }

    // Modal Quit Dialog overlay (en üstte çizilmesi için dosyanın sonunda)
    if show_quit_dialog: TouchArea {
        scroll-event(event) => { return accept; }
        width: 100%;
        height: 100%;

        Rectangle {
            width: 100%; height: 100%; background: Theme.scrim_strong;
            opacity: root.show_quit_dialog ? 1.0 : 0.0;
            animate opacity { duration: 200ms; easing: ease-out; }
        }

        Rectangle {
            width: 320px;
            height: quit_content.preferred-height;
            background: Theme.bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.surface;
            drop-shadow-blur: 15px;
            drop-shadow-color: Theme.shadow;

            quit_content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: center;

                Text { text: Tr.quit_title; font-size: 1.2rem; font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: Tr.quit_body; font-size: 0.9rem; color: Theme.text_muted; horizontal-alignment: center; wrap: word-wrap; }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;
                    height: 40px;
                    DarkButton {
                        text: Tr.cancel;
                        width: 120px;
                        clicked => { root.show_quit_dialog = false; }
                    }
                    DangerButton {
                        text: Tr.quit;
                        width: 130px;
                        clicked => { root.fully_quit_requested(); }
                    }
                }
            }
        }
    }
    } // fs (FocusScope): tüm pencere içeriğini sarar
}
